    {
      "name": "Primary Run button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Enabled and disabled Run appearance. Static component preview; no run is submitted.",
      "html": "<button class=\"ds-run\" type=\"button\">Run RoboHarness</button>",
      "css": ".ds-run{font-family:Arial,Helvetica,sans-serif;line-height:1.5;transition:background .16s ease-out,color .16s ease-out;border:0;cursor:pointer;width:100%;padding:13px 14px;border-radius:7px;background:var(--blue,#174ea6);color:white;font-size:15px;font-weight:600}.ds-run:hover:not(:disabled){background:#0d3c85}.ds-run:focus-visible{outline:3px solid var(--focus,#1a73e8);outline-offset:3px;}.ds-run:disabled{background:#d8dfe8;color:#4c5764;opacity:1;cursor:not-allowed}@media(max-width:760px){.ds-run{min-height:44px}} @media(prefers-reduced-motion:reduce){.ds-run{transition:none!important}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined recovery and refresh actions.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Refresh runtime status</button>",
      "css": ".ds-secondary{font-family:Arial,Helvetica,sans-serif;line-height:1.5;transition:background .16s ease-out,color .16s ease-out;background:transparent;color:var(--ink,#202124);border:1px solid #b6bec8;border-radius:6px;padding:9px 13px;font-size:13px;cursor:pointer}.ds-secondary:hover:not(:disabled){background:#edf1f6}.ds-secondary:focus-visible{outline:3px solid var(--focus,#1a73e8);outline-offset:3px;}.ds-secondary:disabled{opacity:.55;cursor:not-allowed}@media(max-width:760px){.ds-secondary{min-height:44px}} @media(prefers-reduced-motion:reduce){.ds-secondary{transition:none!important}}"
    },
    {
