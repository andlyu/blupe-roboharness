[Unit]
Description=RoboHarness BluPe integration
After=network-online.target blupe-codex-broker.service
Wants=network-online.target blupe-codex-broker.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=ubuntu
Group=ubuntu
SupplementaryGroups=blupe-codex-ipc
WorkingDirectory=/home/ubuntu/blupe-roboharness/site
StateDirectory=blupe-roboharness
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MUJOCO_GL=osmesa
Environment=YAM_RUN_NAMES_DATABASE=/var/lib/blupe-roboharness/run-names.sqlite3
Environment=YAM_SUBMISSION_DATABASE=/var/lib/blupe-roboharness/queue-submissions.sqlite3
Environment=YAM_SOCIAL_DATABASE=/var/lib/blupe-roboharness/run-socials.sqlite3
Environment=YAM_ASSESSMENT_DATABASE=/var/lib/blupe-roboharness/run-assessments.sqlite3
Environment=YAM_TASK_CLOUD_DATABASE=/var/lib/blupe-roboharness/task-cloud.sqlite3
ExecStart=/home/ubuntu/blupe-roboharness/venv/bin/python backend/serve.py --runner-source /home/ubuntu/blupe-roboharness/runner/codex-runner --origin https://roboharness.54.209.185.15.sslip.io --recording-root /var/lib/blupe-roboharness/recordings --preflight /home/ubuntu/blupe-roboharness/preflight.json --broker-socket /run/blupe-codex-broker/model.sock --hosting-app-source /home/ubuntu/blupe-evals/apps/blupe_web
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
LimitCORE=0
MemoryMax=1G
MemorySwapMax=0
UMask=0077

[Install]
WantedBy=multi-user.target
